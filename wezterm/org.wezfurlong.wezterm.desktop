[Desktop Entry]
# Shadows the package's entry, whose `wezterm start --cwd .` skips
# default_gui_startup_args and so opens a window outside the mux session.
Name=WezTerm
Comment=Wez's Terminal Emulator
Keywords=shell;prompt;command;commandline;cmd;
Icon=org.wezfurlong.wezterm
StartupWMClass=org.wezfurlong.wezterm
TryExec=wezterm
Exec=wezterm
Type=Application
Categories=System;TerminalEmulator;Utility;
Terminal=false
