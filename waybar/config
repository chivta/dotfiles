{
    "layer": "top",
    "position": "top",
    "height": 28,
    "spacing": 5,

    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["wireplumber", "custom/wireguard", "hyprland/language", "tray", "custom/swaync"],
	

    "hyprland/workspaces": {
        "format": "{name}",
        "sort-by-number": true,
        "all-outputs": false,
        "active-only": false,
        "persistent-workspaces": {
            "1": [],
        }
    },

    "clock": {
        "format": "{:%H:%M | %d.%m.%Y}"
    },

    "wireplumber": {
        "format": "VOL {volume}%",
        "max-volume": 100,
        "scroll-step": 5,
        "on-click": "kitty --class floating -e pulsemixer"
    },

    "battery": {
        "bat": "BAT1",
        "interval": 60,
        "format": "BAT {capacity}%"
    },

    "memory": {
        "interval": 30,
        "format": "MEM {used:0.1f}G"
    },

    "temperature": {
        "format": "{temperatureC}°C"
    },

    "network": {
        "format-wifi": "WIFI",
        "format-disconnected": "NET OFF",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)",
        "tooltip-format-disconnected": "Disconnected"
    },

    "bluetooth": {
        "format-connected": "BT ON",
        "tooltip-format": "{controller_alias}\t{controller_address}",
        "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}"
    },

    "hyprland/language": {
        "format": "{short}",
        "min-length": 3,
        "max-length": 3
    },

    "tray": {
        "icon-size": 16,
        "spacing": 16
    },

